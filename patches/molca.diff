+def _ablate(graphs, smiles_prompt):
+    """Inference-time channel interventions. No-op unless an env var is set.
+
+    Rotation is within-batch, so a substituted graph is always a real molecule
+    from the same split. That isolates 'wrong molecule' from 'invalid input'.
+    """
+    import copy as _copy
+    import torch as _torch
+    if os.environ.get('MOLCA_SHUFFLE_GRAPH') == '1':
+        graphs = graphs[1:] + graphs[:1]
+    if os.environ.get('MOLCA_SHUFFLE_GRAPH_REV') == '1':
+        graphs = graphs[-1:] + graphs[:-1]
+    if os.environ.get('MOLCA_SHUFFLE_SMILES') == '1':
+        smiles_prompt = smiles_prompt[1:] + smiles_prompt[:1]
+    if os.environ.get('MOLCA_REWIRE_GRAPH') == '1':
+        out = []
+        for g in graphs:
+            g = _copy.copy(g)
+            if g.edge_index is not None and g.edge_index.numel() > 0:
+                n, e = int(g.x.size(0)), g.edge_index.size(1)
+                g.edge_index = _torch.randint(0, n, (2, e), dtype=g.edge_index.dtype)
+            out.append(g)
+        graphs = tuple(out)
+    if os.environ.get('MOLCA_NULL_GRAPH') == '1':
+        out = []
+        for g in graphs:
+            g = _copy.copy(g)
+            g.x = _torch.zeros_like(g.x)
+            out.append(g)
+        graphs = tuple(out)
+    return graphs, smiles_prompt
+
+
