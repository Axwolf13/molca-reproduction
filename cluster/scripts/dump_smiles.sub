universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = run_dump_smiles.sh
output                  = runlogs/dump_smiles.$(ClusterId).out
error                   = runlogs/dump_smiles.$(ClusterId).err
log                     = runlogs/dump_smiles.$(ClusterId).log
should_transfer_files   = YES
request_GPUs = 0
request_CPUs            = 8
request_memory          = 32G
requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true
stream_output = True
stream_error  = True
queue
