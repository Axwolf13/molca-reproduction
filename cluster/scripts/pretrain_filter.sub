universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = run_pretrain_filter.sh
output                  = runlogs/pretrain_filter.$(ClusterId).out
error                   = runlogs/pretrain_filter.$(ClusterId).err
log                     = runlogs/pretrain_filter.$(ClusterId).log
should_transfer_files   = YES
request_GPUs            = 1
request_CPUs            = 8
request_memory          = 32G
requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true
stream_output = True
stream_error  = True
queue
